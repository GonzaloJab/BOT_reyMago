# EJEMPLO. Cópialo a .env y cambia todos los valores. Este archivo no arranca el bot.

# Clave que el bot usa para hablar con WAHA. Inventa una larga.
WAHA_API_KEY=
WAHA_DASHBOARD_USERNAME=waha
WAHA_DASHBOARD_PASSWORD=
WHATSAPP_SWAGGER_USERNAME=waha
WHATSAPP_SWAGGER_PASSWORD=

# Chat completions compatible con OpenAI. La base acaba en /openai/v1, sin /responses.
LLM_BASE_URL=https://TU-RECURSO.services.ai.azure.com/openai/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.6-luna

# Cada cuántos días se pregunta a quien aún no ha pedido nada. 0 lo apaga.
NUDGE_EVERY_DAYS=2

# En casa se pueden omitir: el compose usa la IP de la LAN.
# En el servidor, pon la IP de Tailscale (100.x.x.x), no 0.0.0.0.
# HOST_BIND=100.x.x.x
# PUBLIC_HOST=100.x.x.x
